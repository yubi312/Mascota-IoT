<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================
     PANTALLA 7: VER PERFIL — MascotaIoT
     Avatar con inicial + filas de datos con íconos vectoriales
     ===================================================== -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradiente_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER CON AVATAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:background="@drawable/bg_header_ambar"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:paddingHorizontal="20dp">

            <!-- Avatar circular con ícono vectorial de cuenta -->
            <androidx.cardview.widget.CardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="@color/fondo_oscuro"
                app:cardElevation="8dp"
                android:layout_marginBottom="10dp"
                tools:ignore="VisualLintBounds">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_account"
                    app:tint="@color/ambar_primario"
                    android:contentDescription="@string/titulo_perfil" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nombre_usuario_placeholder"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/fondo_oscuro"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_perfil"
                android:textSize="12sp"
                android:textColor="@color/fondo_oscuro"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp"
                tools:ignore="TextContrastCheck" />
        </LinearLayout>

        <!-- ===== CARD DE DATOS ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@color/card_fondo"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            tools:ignore="VisualLintBounds">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- RUT -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/ambar_primario"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/label_rut" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/label_rut" android:textSize="12sp" android:textColor="@color/blanco_70"
                            android:letterSpacing="0.12"/>
                        <TextView android:id="@+id/tvRut" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/valor_vacio"
                            android:textSize="15sp" android:textColor="@color/blanco" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/bg_separador" android:layout_marginVertical="2dp"/>

                <!-- Nombre -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/ambar_primario"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/label_nombre" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/label_nombre" android:textSize="12sp" android:textColor="@color/blanco_70"
                            android:letterSpacing="0.12"/>
                        <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/valor_vacio"
                            android:textSize="15sp" android:textColor="@color/blanco" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/bg_separador" android:layout_marginVertical="2dp"/>

                <!-- Apellido -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/ambar_primario"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/label_apellido" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/label_apellido" android:textSize="12sp" android:textColor="@color/blanco_70"
                            android:letterSpacing="0.12"/>
                        <TextView android:id="@+id/tvApellido" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/valor_vacio"
                            android:textSize="15sp" android:textColor="@color/blanco" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/bg_separador" android:layout_marginVertical="2dp"/>

                <!-- Correo -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_email"
                        app:tint="@color/ambar_primario"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/label_correo" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/label_correo" android:textSize="12sp" android:textColor="@color/blanco_70"
                            android:letterSpacing="0.12"/>
                        <TextView android:id="@+id/tvCorreo" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/valor_vacio"
                            android:textSize="14sp" android:textColor="@color/ambar_primario"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/bg_separador" android:layout_marginVertical="2dp"/>

                <!-- Cargo -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_work"
                        app:tint="@color/ambar_primario"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/label_cargo" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/label_cargo" android:textSize="12sp" android:textColor="@color/blanco_70"
                            android:letterSpacing="0.12"/>
                        <TextView android:id="@+id/tvCargo" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/valor_vacio"
                            android:textSize="15sp" android:textColor="@color/blanco" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@drawable/bg_separador" android:layout_marginVertical="2dp"/>

                <!-- Contraseña -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/ambar_primario"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/label_contrasena" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/label_contrasena" android:textSize="12sp" android:textColor="@color/blanco_70"
                            android:letterSpacing="0.12"/>
                        <TextView android:id="@+id/tvContrasena" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/contrasena_oculta"
                            android:textSize="18sp" android:textColor="#78909C"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== BOTÓN VOLVER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:minWidth="220dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/card_fondo"
                android:textColor="@color/ambar_primario"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/volver"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/ambar_primario"
                app:iconGravity="textStart"
                app:cornerRadius="14dp"
                app:strokeColor="@color/ambar_primario"
                app:strokeWidth="1.5dp"
                tools:ignore="VisualLintButtonBounds" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
