<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================
     PANTALLA 6: ESTADÍSTICAS — MascotaIoT
     4 tarjetas métricas estilo dashboard IoT con íconos vectoriales
     ===================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradiente_principal">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:background="@drawable/bg_header_ambar"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nombre_usuario_placeholder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/fondo_oscuro"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_estadisticas_completo"
            android:textSize="12sp"
            android:textColor="@color/fondo_oscuro"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <!-- ===== GRID DE MÉTRICAS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical">

        <!-- Fila 1: Activaciones + Desactivaciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Card Activaciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/card_fondo"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                tools:ignore="VisualLintBounds">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_power"
                        app:tint="@color/verde_claro"
                        android:contentDescription="@string/label_activaciones" />

                    <TextView
                        android:id="@+id/tvActivaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_inicial_numero"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_claro"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_activaciones"
                        android:textSize="12sp"
                        android:textColor="@color/blanco_70"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Desactivaciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/card_fondo"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                tools:ignore="VisualLintBounds">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_door_closed"
                        app:tint="#EF9A9A"
                        android:contentDescription="@string/label_desactivaciones" />

                    <TextView
                        android:id="@+id/tvDesactivaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_inicial_numero"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#EF9A9A"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_desactivaciones"
                        android:textSize="12sp"
                        android:textColor="@color/blanco_70"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Fila 2: Obstáculos + Distancia Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Card Obstáculos Detectados -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/card_fondo"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                tools:ignore="VisualLintBounds">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/ambar_primario"
                        android:contentDescription="@string/label_obstaculos" />

                    <TextView
                        android:id="@+id/tvObstaculos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_inicial_numero"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/ambar_primario"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_obstaculos"
                        android:textSize="12sp"
                        android:textColor="@color/blanco_70"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Distancia Total -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/card_fondo"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                tools:ignore="VisualLintBounds">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_distance"
                        app:tint="@color/ambar_claro"
                        android:contentDescription="@string/label_distancia_total" />

                    <TextView
                        android:id="@+id/tvDistanciaTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_inicial_distancia"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/ambar_claro"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_distancia_total"
                        android:textSize="12sp"
                        android:textColor="@color/blanco_70"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Banner sensor ESP32 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@color/fondo_oscuro"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            tools:ignore="VisualLintBounds">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sensor"
                    app:tint="@color/ambar_primario"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/sensor_titulo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_titulo"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/blanco" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_detalle"
                        android:textSize="12sp"
                        android:textColor="@color/blanco_70" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_led_activo" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- ===== FOOTER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:minWidth="220dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/card_fondo"
            android:textColor="@color/ambar_primario"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="@string/volver"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/ambar_primario"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"
            app:strokeColor="@color/ambar_primario"
            app:strokeWidth="1.5dp"
            tools:ignore="VisualLintButtonBounds" />
    </LinearLayout>

</LinearLayout>
