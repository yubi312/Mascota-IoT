<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================
     PANTALLA 5: VER ACCIONES — MascotaIoT
     Lista tipo feed con cards oscuras + badge de acción
     ===================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradiente_principal">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:background="@drawable/bg_header_ambar"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nombre_usuario_placeholder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/fondo_oscuro"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_historial_acciones"
            android:textSize="12sp"
            android:textColor="@color/fondo_oscuro"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <!-- ===== LISTA DE ACCIONES ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAcciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- ===== FOOTER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:minWidth="220dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/card_fondo"
            android:textColor="@color/ambar_primario"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="@string/volver"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/ambar_primario"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"
            app:strokeColor="@color/ambar_primario"
            app:strokeWidth="1.5dp"
            tools:ignore="VisualLintButtonBounds" />
    </LinearLayout>

</LinearLayout>
